# Canonical site URL (keep localhost for local development).
# Set Production to https://zenspace.lat in Vercel.
APP_URL=http://localhost:3000

# Optional public media CDNs. Leave empty until the CDN domains and objects
# have been verified; empty values keep using assets from public/.
NUXT_PUBLIC_CDN_IMAGES_BASE_URL=
NUXT_PUBLIC_CDN_VIDEOS_BASE_URL=
